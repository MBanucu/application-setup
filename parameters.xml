<?xml version="1.0" encoding="UTF-8"?>
<DOCUMENT filename="parameters.xml">
    <!-- "Mr" for male, "Mrs" for female, empty if unknown -->
    <command name="adaptGender">
        <parameter></parameter>
    </command>
    <!-- Defining the receiver's first name -->
    <command name="newcommand">
        <parameter>\prenameReceiver</parameter>
        <parameter></parameter>
    </command>
    <!-- Defining the receiver's surname -->
    <command name="newcommand">
        <parameter>\surnameReceiver</parameter>
        <parameter></parameter>
    </command>
    <!-- Defining the receiver's company -->
    <command name="newcommand">
        <parameter>\companyReceiver</parameter>
        <parameter>Firma</parameter>
    </command>
    <!-- Defining the receiver's street address -->
    <command name="newcommand">
        <parameter>\addressStreetReceiver</parameter>
        <parameter></parameter>
    </command>
    <!-- Defining the receiver's postal code -->
    <command name="newcommand">
        <parameter>\addressPLZReceiver</parameter>
        <parameter></parameter>
    </command>
    <!-- Defining the receiver's city -->
    <command name="newcommand">
        <parameter>\addressPlaceReceiver</parameter>
        <parameter></parameter>
    </command>
    <!-- Defining the receiver's email address -->
    <!-- Collected emails: application contact, responsible person, central company email -->
    <!-- Comma-separated list of emails, no spaces. -->
    <command name="newcommand">
        <parameter>\emailReceiver</parameter>
        <parameter></parameter>
    </command>
    <!-- Stelle laut Stellenanzeige -->
    <command name="newcommand">
        <parameter>\applicationPosition</parameter>
        <parameter>Mensch</parameter>
    </command>
    <!-- Defining the application hyperlink -->
    <command name="newcommand">
        <parameter>\applicationHref</parameter>
        <parameter></parameter>
    </command>
    <!-- Defining the application language -->
    <command name="newcommand">
        <parameter>\applicationLanguage</parameter>
        <parameter>German</parameter>
    </command>
    <!-- Defining the job agent (if any) -->
    <command name="newcommand">
        <parameter>\jobAgent</parameter>
        <parameter></parameter>
    </command>
    <!-- address place of the sender who is the applicant -->
    <command name="newcommand">
        <parameter>\useAddress</parameter>
        <parameter>Essen</parameter>
    </command>
</DOCUMENT>